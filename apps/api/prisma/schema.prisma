// Prisma schema for the Ibn Hayan Healthcare Operating System API.
//
// This is the canonical persistence schema ratified by ADR-006 (Database
// Strategy) and ADR-012 §1.4 (Prisma safeguards). It is PostgreSQL-first:
// every type, constraint, and index is chosen to be expressible in
// PostgreSQL-native SQL, and the generated migration SQL is reviewed
// before being applied to any database.
//
// Per the third canonical batch specification (tenancy foundation):
// - The tenancy foundation (Tenant, Organisation, Facility) is persisted
//   with restricted deletes and no cascading. Tenant deletion is
//   restricted while organisations exist; organisation deletion is
//   restricted while facilities exist.
// - No row-level security policies exist yet. RLS and database-role
//   separation arrive in a dedicated reviewed batch before any
//   tenant-owned data is exposed through a public API endpoint.
// - No soft-delete columns (`deletedAt`). Soft-delete is a future
//   batch concern, governed by a separate ADR.
// - No PostgreSQL extensions are enabled. The schema uses only
//   built-in PostgreSQL features.
//
// Per the fourth canonical batch specification (identity & sessions):
// - User, LocalCredential, TenantMembership, and AuthSession tables are
//   persisted. The User model carries no password hash; the password
//   hash lives on the infrastructure-only LocalCredential row and is
//   never exposed through the domain `User` type (per ADR-013 §1.1
//   point 12 and §1.3 — session records do not include credential
//   material).
// - AuthSession persists only the SHA-256 hash of the opaque session
//   token, never the raw token. The raw token lives only in the
//   HttpOnly cookie and in process memory between generation and
//   cookie-setting (per ADR-013 §1.1 and §1.3).
// - No role or permission columns exist on TenantMembership. The
//   role/permission catalogue is deferred to a subsequent batch.
// - No cascading deletes. All foreign keys use ON DELETE RESTRICT.
// - No seed credentials. The development bootstrap command requires
//   explicit environment variables and creates the dev user idempotently.
//
// Per the fifth canonical batch specification (session tenant context):
// - AuthSession gains a nullable `active_tenant_membership_id` column
//   referencing `tenant_memberships.id`. The column is nullable: a
//   `null` value means "no active Tenant context"; the session
//   remains valid.
// - TenantMembership gains a composite unique constraint on `(id, userId)`
//   to support a composite foreign key from `auth_sessions`. The
//   composite foreign key
//   `auth_sessions(active_tenant_membership_id, user_id)` →
//   `tenant_memberships(id, user_id)` is added by a reviewed raw SQL
//   migration because Prisma 7 cannot express composite foreign keys
//   in the schema language. The composite FK enforces at the database
//   level that a session cannot reference another user's membership.
// - No active Organisation or Facility context columns exist on
//   AuthSession. The fifth batch introduces active Tenant context
//   only.
// - No role or permission context columns exist on AuthSession.
// - No raw Tenant slug, display name, or any denormalised Tenant
//   field is persisted on AuthSession. The session references the
//   Tenant transitively through the selected TenantMembership.
// - ON DELETE RESTRICT on both the single-column and composite
//   foreign keys: deleting a TenantMembership that is referenced by
//   an active session is rejected. This is the structural
//   enforcement of the lifecycle: a selected membership cannot be
//   silently destroyed.
//
// Per the eighth canonical batch specification (RBAC authorization
// foundation):
// - A new `TenantRoleAssignment` model persists the link between a
//   `TenantMembership` and a canonical platform role code (R01
//   through R14). A membership may carry zero or more role
//   assignments; the assignments accumulate permissions per the
//   role-permission matrix defined in `packages/domain/src/
//   authorization/role-permissions.ts`.
// - NO `role` column is added to `TenantMembership`. The simplified
//   `owner`/`member`/`viewer` proposal in
//   `CURRENT_IMPLEMENTATION_HANDOVER.md` is explicitly rejected; it
//   conflicts with the ratified fourteen-role catalogue in
//   PRODUCT_BIBLE.md Section 20.2 and ROLES_AND_PERMISSIONS.md
//   Section 1.2.
// - The `roleCode` column is `VarChar(40)` (the longest canonical
//   code is `R05_ALLIED_HEALTH_PROFESSIONAL` at 29 characters; 40
//   leaves headroom for future custom-role codes that may include
//   tenant prefixes).
// - The unique constraint on `(tenantMembershipId, roleCode)` is the
//   persistence invariant that prevents duplicate role assignments.
//   A duplicate insert raises a Prisma `PrismaClientKnownRequestError`
//   with code `P2002`.
// - `ON DELETE RESTRICT` on the membership foreign key means a
//   membership with active role assignments cannot be deleted until
//   the assignments are deleted first. This prevents silent
//   privilege loss when a membership is repurposed.
// - The migration does NOT insert any rows. Existing memberships
//   remain without role assignments. This is the fail-closed
//   posture: a membership with no assignments has no permissions.
//   The development bootstrap command is updated to explicitly
//   assign R13 System Administrator to the development membership.
// - Customer-defined custom roles are not implemented in this batch.
//   Hierarchical role scope (Organisation, Facility, Department,
//   Care-Team) is deferred. The first slice is Tenant-scoped because
//   the current application only has an active Tenant context.
//
// Per ADR-015 (Scoped Organisation and Facility Context):
// - The `TenantRoleAssignment` model gains three new columns:
//   `scope_level` (NOT NULL, default 'tenant'), `scope_organisation_id`
//   (nullable UUID), and `scope_facility_id` (nullable UUID). The
//   scope level is one of 'tenant', 'organisation', 'facility'.
// - The original unique constraint on `(tenantMembershipId, roleCode)`
//   is replaced by three partial unique indexes (one per scope level)
//   because PostgreSQL treats NULL as distinct in a unique index,
//   which would defeat the constraint for tenant-scoped rows. The
//   partial indexes are added by the reviewed raw SQL migration
//   `20260722100000_scoped_organisation_facility_context` because
//   Prisma 7 cannot express partial unique indexes with NULL
//   predicates in the schema language. The original `@@unique`
//   declaration is removed from this schema and replaced with a
//   plain `@@index` for read-path performance; the partial unique
//   indexes are the structural enforcement of "no duplicate
//   assignments at the same scope".
// - Three CHECK constraints (added by the migration) enforce the
//   scope-target implications:
//   1. `scope_level = 'tenant'` IMPLIES `scope_organisation_id IS NULL
//      AND scope_facility_id IS NULL`.
//   2. `scope_level = 'organisation'` IMPLIES `scope_organisation_id
//      IS NOT NULL AND scope_facility_id IS NULL`.
//   3. `scope_level = 'facility'` IMPLIES `scope_organisation_id IS
//      NOT NULL AND scope_facility_id IS NOT NULL`.
// - Single-column foreign keys `scope_organisation_id` →
//   `organisations.id` and `scope_facility_id` → `facilities.id`
//   are added with `ON DELETE RESTRICT`. The application layer
//   additionally validates that the scope target belongs to the
//   membership's tenant (and, for facility scope, to the supplied
//   organisation).
// - Existing rows are migrated to explicit `tenant` scope with no
//   scope-target by the migration's UPDATE statement. Their behaviour
//   is unchanged.
//
// Per ADR-012 §1.4 safeguard 4 (PostgreSQL-first design): when Prisma's
// schema language cannot express a PostgreSQL concept that the design
// requires, the design is PostgreSQL-correct first and the Prisma
// schema is annotated or supplemented with raw SQL second. The
// composite organisation foreign key —
//   facilities(tenantId, organisationId) REFERENCES organisations(tenantId, id)
// — is one such concept: Prisma 7 cannot express a composite foreign
// key in the schema language. The schema below declares the columns
// and the single-column indexes; the composite foreign key, the
// composite unique constraint on `organisations(tenantId, id)`, and
// the restricted-delete behaviour are added by the reviewed raw SQL
// migration that accompanies the Prisma-generated migration.
//
// The same approach is used for the fifth-batch composite foreign key
//   auth_sessions(active_tenant_membership_id, user_id) REFERENCES tenant_memberships(id, user_id)
// declared in the `session_tenant_context` migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
}

/// A Tenant is the top-level isolation boundary. Every Organisation,
/// Facility, user, patient, and clinical record belongs to exactly one
/// Tenant.
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(80)
  displayName String       @map("display_name") @db.VarChar(200)
  status      TenantStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organisations   Organisation[]
  memberships     TenantMembership[]
  roleAssignments TenantRoleAssignment[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

enum OrganisationStatus {
  active
  inactive
}

/// An Organisation is the second level of the tenancy hierarchy. Every
/// Organisation belongs to exactly one Tenant; the foreign key below
/// enforces that ownership. The unique constraint on `(tenantId, code)`
/// enforces that an Organisation's code is unique within a Tenant but
/// may be reused across Tenants.
///
/// The composite unique constraint on `(tenantId, id)` is required to
/// support the composite foreign key from `facilities`. Prisma cannot
/// express a composite foreign key in the schema language; the
/// composite unique constraint here is supplemented by a reviewed raw
/// SQL migration that adds the composite foreign key on `facilities`.
model Organisation {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  code        String             @db.VarChar(50)
  displayName String             @map("display_name") @db.VarChar(200)
  status      OrganisationStatus @default(active)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facilities      Facility[]
  roleAssignments TenantRoleAssignment[] @relation("TenantRoleAssignmentScopeOrganisation")
  activeSessions  AuthSession[]          @relation("AuthSessionActiveOrganisation")

  @@unique([tenantId, code], map: "organisations_tenant_id_code_key")
  @@unique([tenantId, id], map: "organisations_tenant_id_id_key")
  @@index([tenantId], map: "organisations_tenant_id_idx")
  @@map("organisations")
}

// ---------------------------------------------------------------------------
// Facility
// ---------------------------------------------------------------------------

enum FacilityStatus {
  active
  inactive
}

/// A Facility is the third level of the tenancy hierarchy. Every
/// Facility belongs to exactly one Organisation, which in turn belongs
/// to exactly one Tenant.
///
/// The `tenantId` column is persisted on the facility row so that
/// tenant-scoped queries do not need to join through `organisations`.
/// The composite foreign key
///   facilities(tenantId, organisationId) REFERENCES organisations(tenantId, id)
/// is added by a reviewed raw SQL migration because Prisma 7 cannot
/// express a composite foreign key in the schema language. The
/// composite foreign key enforces that a Facility cannot be attached
/// to an Organisation in a different Tenant: the database rejects the
/// insert.
///
/// The single-column `organisationId` relation below is declared for
/// Prisma's query-builder convenience; the real referential integrity
/// is enforced by the composite foreign key. The single-column
/// relation is configured with `onDelete: Restrict` so that an
/// organisation deletion that would orphan facilities is rejected
/// even if the composite foreign key were ever dropped.
///
/// The `timezone` field holds a valid IANA timezone identifier (e.g.
/// 'Asia/Baghdad', 'Europe/London') that represents the facility's
/// local time zone. It is nullable: null means the timezone has not
/// been configured and the facility is in a configuration-required
/// state. Future "Today's Appointments" queries must return a
/// configuration-required response when this field is null. No
/// fallback to tenant timezone, UTC, server timezone, browser
/// timezone, or any hard-coded default is applied. The application
/// layer must validate that any stored value is a recognised IANA
/// timezone before persisting. This field does not backfill existing
/// rows; existing facilities retain null until explicitly configured.
model Facility {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  code           String         @db.VarChar(50)
  displayName    String         @map("display_name") @db.VarChar(200)
  status         FacilityStatus @default(active)
  timezone       String?        @map("timezone") @db.VarChar(60)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organisation        Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleAssignments     TenantRoleAssignment[]       @relation("TenantRoleAssignmentScopeFacility")
  activeSessions      AuthSession[]                @relation("AuthSessionActiveFacility")
  appointments        Appointment[]
  providerAssignments ProviderFacilityAssignment[]
  providerSchedules   ProviderSchedule[]

  @@unique([tenantId, organisationId, code], map: "facilities_tenant_id_organisation_id_code_key")
  @@unique([id, organisationId], map: "facilities_id_organisation_id_key")
  @@unique([tenantId, organisationId, id], map: "facilities_tenant_id_organisation_id_id_key")
  @@index([tenantId], map: "facilities_tenant_id_idx")
  @@index([tenantId, organisationId], map: "facilities_tenant_id_organisation_id_idx")
  @@map("facilities")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
}

/// A User is an authenticated identity that can sign in to the Ibn
/// Hayan Healthcare Operating System. Every session, membership, and
/// audit event belongs to exactly one User. A User is platform-scoped
/// (not tenant-scoped); a User's tenant access is expressed through
/// `TenantMembership` rows.
///
/// Per ADR-013 §1.1, authentication is separated from authorisation.
/// This model represents the authenticated identity only; the
/// authorisation verification chain (ADR-013 §1.4) consults the
/// membership set at every protected API operation.
///
/// This model carries NO password hash. The Argon2id password hash
/// lives on the infrastructure-only `LocalCredential` row, which is
/// keyed by `userId` (one credential per user). The domain `User`
/// type in `packages/domain/src/identity/user.ts` mirrors this shape
/// minus the credential relation; the persistence adapter maps
/// between the two. The password hash is never exposed through the
/// domain `User` type or through any API response.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.VarChar(320)
  normalisedEmail String     @unique @map("normalised_email") @db.VarChar(320)
  displayName     String     @map("display_name") @db.VarChar(200)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  localCredential      LocalCredential?
  memberships          TenantMembership[]
  sessions             AuthSession[]
  userProviderBindings UserProviderBinding[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

// ---------------------------------------------------------------------------
// LocalCredential
// ---------------------------------------------------------------------------

/// A LocalCredential stores the Argon2id password hash for a User.
/// There is exactly one credential per user (enforced by using
/// `userId` as the primary key). The credential row is never exposed
/// through the domain `User` type or through any API response; it is
/// consumed only by the infrastructure-only `LocalCredentialService`
/// in `apps/api/src/infrastructure/database/`, which is in turn
/// consumed by the `PasswordService` and `AuthService`.
///
/// `ON DELETE RESTRICT` means a User with a credential cannot be
/// deleted until the credential is deleted first. This is a
/// defence-in-depth measure: it prevents an accidental `delete user`
/// from silently orphaning the credential row.
///
/// The `passwordHash` field stores the PHC-string-formatted Argon2id
/// hash (e.g. `$argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>`). The
/// hash includes the salt, the parameters, and the version, so
/// parameter changes are forward-compatible.
model LocalCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @map("password_changed_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("local_credentials")
}

// ---------------------------------------------------------------------------
// TenantMembership
// ---------------------------------------------------------------------------

enum TenantMembershipStatus {
  active
  suspended
}

/// A TenantMembership is the link between a User and a Tenant. A User
/// may hold at most one membership per Tenant (enforced by the unique
/// constraint on `(tenantId, userId)`). A User's set of memberships
/// determines the Tenants they may operate within.
///
/// Per the eighth canonical batch specification, this model carries
/// NO `role` column. Roles are persisted through the separate
/// `TenantRoleAssignment` model, which allows a membership to carry
/// zero or more role assignments simultaneously (per
/// PRODUCT_BIBLE.md Section 20.3 — roles are composable). The
/// simplified `owner`/`member`/`viewer` proposal in
/// `CURRENT_IMPLEMENTATION_HANDOVER.md` is explicitly rejected; it
/// conflicts with the ratified fourteen-role catalogue.
///
/// Per the fifth canonical batch specification, this model gains a
/// composite unique constraint on `(id, userId)`. The composite
/// uniqueness exists specifically to support a database-enforced
/// same-user context constraint: the composite foreign key
/// `auth_sessions(active_tenant_membership_id, user_id)` →
/// `tenant_memberships(id, user_id)` rejects any attempt to set a
/// session's active context to a membership owned by a different
/// user. Prisma 7 cannot express a composite foreign key in the
/// schema language; the composite FK is added by a reviewed raw SQL
/// migration in `session_tenant_context`. The composite unique
/// constraint here is required for the composite FK to be valid in
/// PostgreSQL.
///
/// `ON DELETE RESTRICT` on both foreign keys means:
/// - A Tenant with active memberships cannot be deleted (the
///   memberships must be deleted first).
/// - A User with active memberships cannot be deleted (the
///   memberships must be deleted first).
/// This is the structural enforcement of the lifecycle: a tenant or
/// user with active relationships cannot be silently destroyed.
model TenantMembership {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  status    TenantMembershipStatus @default(active)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleAssignments TenantRoleAssignment[]

  @@unique([tenantId, userId], map: "tenant_memberships_tenant_id_user_id_key")
  @@unique([id, userId], map: "tenant_memberships_id_user_id_key")
  @@unique([id, tenantId], map: "tenant_memberships_id_tenant_id_key")
  @@index([tenantId], map: "tenant_memberships_tenant_id_idx")
  @@index([userId], map: "tenant_memberships_user_id_idx")
  @@map("tenant_memberships")
}

// ---------------------------------------------------------------------------
// TenantRoleAssignment
// ---------------------------------------------------------------------------

/// A TenantRoleAssignment is the link between a TenantMembership and
/// a canonical platform role code (R01 through R14). A membership
/// may carry zero or more role assignments; the assignments
/// accumulate permissions per the role-permission matrix defined in
/// `packages/domain/src/authorization/role-permissions.ts`.
///
/// Per PRODUCT_BIBLE.md Section 20.3 and the eighth canonical batch
/// specification, roles are composable: a principal may hold
/// multiple roles simultaneously, with permissions accumulating per
/// defined rules. This model is the structural expression of
/// composability: instead of placing one role directly on
/// `TenantMembership`, each assignment is its own row, and a
/// membership may have many.
///
/// Per ROLES_AND_PERMISSIONS.md Section 1.6, roles are tenant-scoped.
/// The tenant scoping is enforced structurally: every
/// `TenantRoleAssignment` references a `TenantMembership`, which in
/// turn references exactly one `Tenant`. A cross-tenant role
/// assignment is therefore impossible at the data-model level.
///
/// The unique constraint on `(tenantMembershipId, roleCode)` is the
/// persistence invariant that prevents duplicate role assignments.
/// A duplicate insert raises a Prisma
/// `PrismaClientKnownRequestError` with code `P2002`, which the API
/// exception layer translates to a 409 Conflict.
///
/// The `roleCode` column is `VarChar(40)`. The longest canonical
/// code is `R05_ALLIED_HEALTH_PROFESSIONAL` at 29 characters; 40
/// leaves headroom for future custom-role codes that may include
/// tenant prefixes. The persistence adapter validates that the code
/// is in the canonical catalogue before insertion; an unknown code
/// is rejected with a domain error.
///
/// Database-level CHECK constraint: the corrective migration
/// `20260719120000_rbac_role_code_check_constraint` adds a
/// PostgreSQL CHECK constraint named
/// `tenant_role_assignments_role_code_check` that limits
/// `role_code` to exactly the fourteen canonical platform role
/// codes (R01_PHYSICIAN through R14_INTEGRATION_ACCOUNT). This
/// enforces the role-code catalogue STRUCTURALLY at the database
/// level, so that a SQL INSERT/UPDATE bypassing the application
/// layer cannot persist an unknown role code. Prisma 7.8 does not
/// support a `@check` schema annotation; the constraint is
/// therefore declared in raw SQL in the migration, not in this
/// schema file. The schema and the database are kept in sync by
/// the migration history; `prisma migrate deploy` applies the
/// constraint, and `prisma validate` does not detect drift
/// because Prisma does not introspect CHECK constraints into the
/// schema language.
///
/// `ON DELETE RESTRICT` on the membership foreign key means a
/// membership with active role assignments cannot be deleted until
/// the assignments are deleted first. This prevents silent privilege
/// loss when a membership is repurposed.
///
/// The migration that creates this table does NOT insert any rows.
/// Existing memberships remain without role assignments. This is the
/// fail-closed posture: a membership with no assignments has no
/// permissions. The development bootstrap command is updated to
/// explicitly assign R13 System Administrator to the development
/// membership.
model TenantRoleAssignment {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantMembershipId  String   @map("tenant_membership_id") @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  roleCode            String   @map("role_code") @db.VarChar(40)
  scopeLevel          String   @default("tenant") @map("scope_level") @db.VarChar(20)
  scopeOrganisationId String?  @map("scope_organisation_id") @db.Uuid
  scopeFacilityId     String?  @map("scope_facility_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenantMembership  TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeOrganisation Organisation?    @relation("TenantRoleAssignmentScopeOrganisation", fields: [scopeOrganisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeFacility     Facility?        @relation("TenantRoleAssignmentScopeFacility", fields: [scopeFacilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantMembershipId], map: "tenant_role_assignments_tenant_membership_id_idx")
  @@index([tenantId], map: "tenant_role_assignments_tenant_id_idx")
  @@index([roleCode], map: "tenant_role_assignments_role_code_idx")
  @@index([scopeOrganisationId], map: "tenant_role_assignments_scope_organisation_id_idx")
  @@index([scopeFacilityId], map: "tenant_role_assignments_scope_facility_id_idx")
  @@index([tenantMembershipId, roleCode, scopeLevel], map: "tenant_role_assignments_membership_role_scope_idx")
  @@map("tenant_role_assignments")
}

// ---------------------------------------------------------------------------
// AuthSession
// ---------------------------------------------------------------------------

/// An AuthSession is a server-side record representing an authenticated
/// browser session. Per ADR-013 §1.1 and §1.3, sessions are
/// server-managed and opaque: the browser holds only an opaque,
/// high-entropy session identifier in an HttpOnly cookie; the server
/// holds this record in the transactional store.
///
/// The `tokenHash` field stores the SHA-256 hash of the opaque session
/// token. The raw token is NEVER persisted. It lives only in the
/// HttpOnly cookie and in process memory between generation and
/// cookie-setting. The `tokenHash` is a fixed-length 64-character
/// lowercase hexadecimal string (256 bits / 4 bits per hex character).
///
/// `expiresAt` is the absolute expiry timestamp. A session is
/// considered expired once `now >= expiresAt`.
///
/// `lastSeenAt` is updated on every session-validation touch
/// (subject to the idle-touch interval).
///
/// `rotatedAt` is the timestamp of the most recent token rotation,
/// or null if the session has never been rotated.
///
/// `revokedAt` is the timestamp of explicit revocation, or null if
/// the session is not revoked. Once set, the session is no longer
/// active regardless of `expiresAt`.
///
/// `activeTenantMembershipId` is the TenantMembership this session has
/// selected as its active Tenant context, or null when no context is
/// selected. Per the fifth canonical batch specification:
/// - The active context is session-specific: different sessions for
///   the same user have independent context.
/// - Selection is by TenantMembership ID, never by an arbitrary
///   Tenant ID. The session cannot be forced into a Tenant for
///   which the user has no membership.
/// - The single-column foreign key `active_tenant_membership_id` →
///   `tenant_memberships.id` enforces that the referenced row exists.
/// - The composite foreign key
///   `auth_sessions(active_tenant_membership_id, user_id)` →
///   `tenant_memberships(id, user_id)` (added by the
///   `session_tenant_context` raw SQL supplement) enforces that
///   the referenced membership belongs to this session's user. A
///   cross-user selection is rejected at the database level.
/// - Both foreign keys use ON DELETE RESTRICT: deleting a membership
///   that is referenced by an active session is rejected.
/// - No active Organisation or Facility context columns exist on
///   AuthSession. The fifth batch introduces active Tenant context
///   only.
/// - No raw Tenant slug, display name, or any denormalised Tenant
///   field is persisted on AuthSession. The session references the
///   Tenant transitively through the selected TenantMembership.
/// - No role or permission context columns exist on AuthSession.
///
/// `ON DELETE RESTRICT` on the user foreign key means a User with
/// sessions cannot be deleted until the sessions are revoked or
/// deleted first.
///
/// Per ADR-015 (Scoped Organisation and Facility Context):
/// - The AuthSession model gains two nullable UUID columns:
///   `active_organisation_id` and `active_facility_id`. Both are
///   nullable: `null` means "no active context at this level"; the
///   session remains valid.
/// - Single-column foreign keys `active_organisation_id` →
///   `organisations.id` and `active_facility_id` → `facilities.id`
///   are added with `ON DELETE RESTRICT`. The application layer
///   additionally validates that the active organisation belongs to
///   the active tenant and that the active facility belongs to the
///   active organisation and active tenant.
/// - A composite foreign key
///   `auth_sessions(active_facility_id, active_organisation_id)` →
///   `facilities(id, organisation_id)` is added by the reviewed raw
///   SQL migration `20260722100000_scoped_organisation_facility_context`
///   because Prisma 7 cannot express composite foreign keys in the
///   schema language. The composite FK enforces at the database level
///   that the active facility belongs to the active organisation.
/// - A CHECK constraint (added by the migration) enforces that
///   `active_facility_id IS NULL OR active_organisation_id IS NOT NULL`
///   — a facility cannot remain active without an active organisation.
/// - The cascade-clearing invariants (selecting a new tenant clears
///   the active organisation and facility; selecting a new
///   organisation clears the active facility when the facility does
///   not belong to it; clearing the tenant clears the organisation
///   and the facility; clearing the organisation clears the facility)
///   are enforced at the application layer in the same Prisma
///   transaction as the selection or clearing.
model AuthSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  tokenHash                String    @unique @map("token_hash") @db.Char(64)
  activeTenantMembershipId String?   @map("active_tenant_membership_id") @db.Uuid
  activeOrganisationId     String?   @map("active_organisation_id") @db.Uuid
  activeFacilityId         String?   @map("active_facility_id") @db.Uuid
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt               DateTime  @map("last_seen_at") @db.Timestamptz
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeOrganisation Organisation? @relation("AuthSessionActiveOrganisation", fields: [activeOrganisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFacility     Facility?     @relation("AuthSessionActiveFacility", fields: [activeFacilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([activeTenantMembershipId], map: "auth_sessions_active_tenant_membership_id_idx")
  @@index([activeOrganisationId], map: "auth_sessions_active_organisation_id_idx")
  @@index([activeFacilityId], map: "auth_sessions_active_facility_id_idx")
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// AuditOutboxEvent
// ---------------------------------------------------------------------------

/// An AuditOutboxEvent is a delivery mechanism for audit events from
/// the transactional store to the dedicated audit store.
///
/// Per ADR-014 (Audit Store and Integrity Strategy) and the ninth
/// canonical batch specification, the transactional outbox pattern is
/// the ratified durable delivery mechanism. A state mutation (e.g.
/// session creation, session rotation, logout, context selection,
/// context clearing, role assignment) and its outbox record commit
/// atomically in the same transaction. The mutation cannot commit
/// without its outbox record.
///
/// The outbox is NOT the final audit trail. The final audit trail
/// lives in the dedicated audit database (`audit_events` table in
/// `apps/api/prisma-audit/schema.prisma`). The outbox is mutable
/// (the dispatcher updates `attempt_count`, `delivered_at`,
/// `last_failure_code`, `last_failure_at`, `lease_owner`,
/// `lease_expires_at`); the audit_events table is immutable.
///
/// The dispatcher claims pending outbox rows using PostgreSQL-safe
/// claiming (`FOR UPDATE SKIP LOCKED`), appends each to the audit
/// store, and marks the row delivered only after successful
/// audit-store insertion. An existing `event_id` in the audit store
/// is treated as an idempotent success: the outbox row is marked
/// delivered without producing a duplicate audit record.
///
/// The `event_id` column is unique; it is the structural enforcement
/// of idempotent delivery at the outbox level. A duplicate insert
/// raises a Prisma `PrismaClientKnownRequestError` with code `P2002`.
///
/// The `canonical_event_draft` column is a JSONB column that holds
/// the canonical serialization of the `AuditEventDraft` (defined in
/// `packages/observability`). The dispatcher reads the JSONB,
/// deserialises it into an `AuditEventDraft`, and passes it to the
/// audit store for appending.
///
/// The `delivered_at` column is null for pending events and non-null
/// for delivered events. The partial index
/// `audit_outbox_events_delivered_at_null_idx` (added in the
/// migration) allows the dispatcher to claim pending rows
/// efficiently.
///
/// The `lease_owner` and `lease_expires_at` columns support safe
/// concurrent dispatch. The dispatcher sets these when it claims a
/// row; another dispatcher that finds a row with an expired lease
/// may steal it. The partial index
/// `audit_outbox_events_lease_expires_at_not_null_idx` allows the
/// lease-sweep to find candidate rows efficiently.
///
/// Per ADR-014 §1.1 and the ninth canonical batch specification, the
/// outbox does NOT store secrets. The `canonical_event_draft` is
/// sanitised through the forbidden-key detector before insertion.
model AuditOutboxEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  eventId             String    @unique @map("event_id") @db.Uuid
  eventVersion        Int       @map("event_version")
  canonicalEventDraft Json      @map("canonical_event_draft")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  availableAt         DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("available_at") @db.Timestamptz
  attemptCount        Int       @default(0) @map("attempt_count")
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz
  lastFailureCode     String?   @map("last_failure_code") @db.VarChar(60)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz
  leaseOwner          String?   @map("lease_owner") @db.VarChar(80)
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz

  @@index([deliveredAt, availableAt], map: "audit_outbox_events_delivered_at_available_at_idx")
  @@index([leaseExpiresAt], map: "audit_outbox_events_lease_expires_at_idx")
  @@index([createdAt], map: "audit_outbox_events_created_at_idx")
  @@map("audit_outbox_events")
}

// ---------------------------------------------------------------------------
// Appointment
// ---------------------------------------------------------------------------

/// Canonical appointment lifecycle statuses as defined in
/// download/docs/07_MODULES/APPOINTMENTS.md Section 1 (lifecycle
/// "booked, confirmed, arrived, in-progress, completed, cancelled,
/// no-show").  These values are persisted as-is in the `status` column
/// and are the authoritative enumeration for appointment state machine
/// transitions.
enum AppointmentStatus {
  booked
  confirmed
  arrived
  in_progress
  completed
  cancelled
  no_show
}

/// An Appointment is the operational scheduling record for a patient
/// encounter at a facility.  It is owned by the Scheduling bounded
/// context (BC06) and is the persistence foundation for the R09 Clinic
/// Administrator "Today's Appointments" read-only feature.
///
/// This model intentionally stores only logical identifiers (patient ID,
/// provider ID) and does not create foreign-key references to the
/// Patient or Workforce module tables.  Those modules own their own
/// identity and schema; this model references their identifiers by
/// value.  Patient names, provider names, specialties, payment status,
/// and wait-time data are NOT stored here.
///
/// The `facility` relation provides Prisma query-builder convenience.
/// The single-column foreign key is supplemented by a triple-column
/// composite foreign key (added by the reviewed migration) that enforces
/// at the database level that the appointment's tenant_id, organisation_id,
/// and facility_id all match the corresponding values of the referenced
/// facility.
///
/// All timestamps are stored in UTC using PostgreSQL timestamptz.
/// The facility's local time is derived at the application layer by
/// consulting the facility's `timezone` field; if null, the facility
/// is in a configuration-required state and "Today's Appointments"
/// must return an appropriate response.
///
/// This model does NOT backfill existing rows.  New appointments are
/// created by application-layer logic; no seed or historical import is
/// performed by this schema change.
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  facilityId     String            @map("facility_id") @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  providerId     String            @map("provider_id") @db.Uuid
  scheduledStart DateTime          @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime          @map("scheduled_end") @db.Timestamptz
  status         AppointmentStatus @default(booked)
  typeCode       String            @map("type_code") @db.VarChar(80)
  // Optional free-text no-show justification (max 500 chars), persisted
  // only on the first confirmed|arrived -> no_show transition. An
  // idempotent re-mark does NOT overwrite the original value. Free-text
  // is stored here (on the appointment row), NOT in generic audit
  // metadata, to keep the audit trail PHI-safe.
  noShowReason   String?           @map("no_show_reason") @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId], map: "appointments_tenant_id_idx")
  @@index([tenantId, organisationId], map: "appointments_tenant_id_organisation_id_idx")
  @@index([tenantId, facilityId], map: "appointments_tenant_id_facility_id_idx")
  @@index([tenantId, scheduledStart], map: "appointments_tenant_id_scheduled_start_idx")
  @@index([tenantId, facilityId, scheduledStart], map: "appointments_tenant_id_facility_id_scheduled_start_idx")
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Patient
// ---------------------------------------------------------------------------

/// Patient lifecycle status.
enum PatientStatus {
  active
  inactive
  deceased
  transferred_out
  archived
}

/// The canonical patient identity for the Ibn Hayan Healthcare Operating System.
///
/// Per download/docs/07_MODULES/PATIENTS.md:
/// - Patient records are tenant-isolated by default
/// - A patient created in tenant A is not visible to tenant B
/// - Cross-facility identity resolution means a patient identity is visible
///   across all facilities within a tenant
/// - MRN (Medical Record Number) is tenant-wide and unique
///
/// This model implements the minimal canonical Patient persistence foundation
/// required for other bounded contexts to verify that a patient reference
/// genuinely exists within the authenticated tenant scope.
///
/// Deliberately excluded (not in this minimal foundation):
/// - Demographics (name, date of birth, sex, gender, language)
/// - Contact information (address, telephone, email, emergency contact)
/// - Insurance coverage details
/// - Consent records
/// - Medical history
/// - Family/payer relationships
///
/// These fields will be added in subsequent batches as patient registration
/// and demographics are implemented.
model Patient {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  medicalRecordNumber  String                 @map("medical_record_number") @db.VarChar(50)
  status               PatientStatus          @default(active)
  // Demographic columns (BC01 Demographics/Registration/Consent). All are
  // nullable at the database level so that existing minimal Patient rows
  // (created by the reference foundation) remain valid (architecture gate
  // 24). A new complete registration API requires the canonical identity
  // demographics (name, DOB, sex); the historical minimal rows keep null
  // demographics. Database nullability is separated from new-registration
  // API validation.
  legalGivenName       String?                @map("legal_given_name") @db.VarChar(100)
  legalMiddleName      String?                @map("legal_middle_name") @db.VarChar(100)
  legalFamilyName      String?                @map("legal_family_name") @db.VarChar(100)
  preferredName        String?                @map("preferred_name") @db.VarChar(100)
  // Exact date of birth as an ISO 8601 calendar date (YYYY-MM-DD). Stored
  // as a DATE (not TIMESTAMPTZ) because DOB is a calendar date, not an
  // instant; a DATE avoids timezone-interpretation ambiguity. No computed
  // age is stored (architecture gate 6D). Nullable for historical rows.
  dateOfBirth          DateTime?              @map("date_of_birth") @db.Date
  sex                  PatientSex?
  genderIdentity       PatientGenderIdentity? @map("gender_identity")
  genderIdentityDetail String?                @map("gender_identity_detail") @db.VarChar(100)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  identifiers PatientIdentifier[]
  consents    PatientConsent[]

  @@unique([tenantId, medicalRecordNumber], map: "patients_tenant_id_medical_record_number_key")
  @@index([tenantId], map: "patients_tenant_id_idx")
  @@index([tenantId, legalFamilyName], map: "patients_tenant_id_legal_family_name_idx")
  @@index([tenantId, legalGivenName], map: "patients_tenant_id_legal_given_name_idx")
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Patient demographics & consent (BC01 Demographics/Registration/Consent)
// ---------------------------------------------------------------------------

/// Canonical patient sex (biological sex) per ENUMS.md §3 (PatientSex,
/// Closed). Distinct from gender identity.
enum PatientSex {
  male
  female
  intersex
  unknown
  not_declared
}

/// Canonical patient gender identity per ENUMS.md §3 (PatientGenderIdentity,
/// Open-with-Council). Distinct from biological sex.
enum PatientGenderIdentity {
  male
  female
  transgender_male
  transgender_female
  non_binary
  prefer_not_to_say
  other
}

/// Canonical patient identifier type per ENUMS.md §3
/// (PatientIdentifierType, Open-with-Council). The
/// `medical_record_number` value is NOT used by the PatientIdentifier
/// model — the MRN remains on the Patient table.
enum PatientIdentifierType {
  national_id
  passport
  medical_record_number
  insurance_number
  driver_licence
}

/// Canonical consent type per ENUMS.md §3 (ConsentType). The BC01 API
/// accepts `treatment` only in this stage; the other types are canonical
/// but deferred.
enum ConsentType {
  treatment
  information_disclosure
  research
  marketing
  data_sharing
}

/// Canonical consent status per ENUMS.md §3 (ConsentStatus). NO
/// `declined` value exists (architecture gate 6L). Refusal is the
/// absence of an active granted consent.
enum ConsentStatus {
  granted
  withdrawn
  pending
  expired
}

/// Canonical consent scope per ENUMS.md §3 (ConsentScope).
enum ConsentScope {
  general
  specific
  emergency
}

/// Canonical consent duration per ENUMS.md §3 (ConsentDuration).
/// `single_encounter` is REJECTED by the BC01 API (architecture gate 6K)
/// because no canonical integration event exists to expire it at
/// encounter completion. The enum value exists in the database catalogue
/// but the API rejects it; a future stage wires the encounter-completion
/// event and enables it truthfully.
enum ConsentDuration {
  indefinite
  fixed_term
  single_encounter
}

/// The method by which consent was captured (compliance provenance).
enum ConsentCaptureMethod {
  in_person
  written
  verbal
  electronic
  guardian_authorization
}

/// A secondary patient identifier (NationalID, Passport, InsuranceNumber,
/// DriverLicence) distinct from the MRN (which remains on the Patient
/// table for backward compatibility, per architecture gate 6G). Within
/// BC01, a foreign key to Patient is permitted (same bounded context).
///
/// Per architecture gate 6O, sensitive identifiers (NationalID, Passport)
/// are stored as plaintext in the transactional database (consistent with
/// all other patient PHI), protected by tenant isolation, authorization,
/// and audit-metadata forbidden-key rules. No custom field-level
/// cryptography is invented. The `normalized_value` is NEVER placed in
/// audit metadata or application logs.
///
/// Deterministic duplicate prevention (architecture gate 6H): NationalID
/// and Passport have a partial unique index on
/// `(tenant_id, type, normalized_value)` added by the migration (Prisma 7
/// cannot express partial unique indexes with type-predicates in the
/// schema language). The `@@unique` declaration is omitted here in favour
/// of the raw-SQL partial unique index in the migration, matching the
/// ProviderFacilityAssignment convention.
model PatientIdentifier {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  patientId       String                @map("patient_id") @db.Uuid
  type            PatientIdentifierType
  normalizedValue String                @map("normalized_value") @db.VarChar(100)
  issuingCountry  String?               @map("issuing_country") @db.VarChar(2)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId], map: "patient_identifiers_tenant_id_idx")
  @@index([tenantId, patientId], map: "patient_identifiers_tenant_id_patient_id_idx")
  @@index([tenantId, type, normalizedValue], map: "patient_identifiers_tenant_type_value_idx")
  @@map("patient_identifiers")
}

/// A dedicated consent model (NOT a boolean field on Patient), per
/// architecture gate 6I. Consent is a first-class, history-preserving
/// lifecycle entity owned by BC01. This stage implements Treatment consent
/// only.
///
/// Consent history semantics (architecture gate 6P): consent records are
/// history-preserving MUTABLE lifecycle records, NOT append-only events.
/// The `status` field transitions (Granted → Withdrawn, Granted → Expired).
/// Every record is retained (no destructive delete). Every status
/// transition is audited. The `grantedAt`, `withdrawnAt`, and `expiresAt`
/// timestamps are preserved across transitions.
///
/// Consent expiry / unique-constraint gate (architecture gate 6J): the
/// one-active-treatment-consent invariant is enforced by a partial unique
/// index on `(tenant_id, patient_id) WHERE consent_type = 'treatment'
/// AND status = 'granted'` added by the migration (Prisma 7 cannot express
/// partial unique indexes in the schema language). The
/// transactional reconciliation-before-grant strategy (run by the
/// repository's grant method within a SERIALIZABLE transaction) ensures
/// expired rows transition to `status = 'expired'` BEFORE a new granted
/// record is inserted, so re-consent after expiry works. No NOW()/
/// current-time predicate is used in the partial unique index (the
/// predicate is `status = 'granted'`, immutable per-row state).
///
/// `capturedBy` is a logical cross-BC reference to the Identity/Access
/// user (a UUID, NOT a FK) because Identity/Access owns User state.
model PatientConsent {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  patientId             String                @map("patient_id") @db.Uuid
  consentType           ConsentType           @map("consent_type")
  status                ConsentStatus         @default(granted)
  scope                 ConsentScope
  duration              ConsentDuration
  grantedAt             DateTime              @default(now()) @map("granted_at") @db.Timestamptz
  withdrawnAt           DateTime?             @map("withdrawn_at") @db.Timestamptz
  expiresAt             DateTime?             @map("expires_at") @db.Timestamptz
  capturedBy            String                @map("captured_by") @db.Uuid
  captureMethod         ConsentCaptureMethod  @map("capture_method")
  policyVersion         String                @map("policy_version") @db.VarChar(50)
  guardianName          String?               @map("guardian_name") @db.VarChar(100)
  guardianRelationship  String?               @map("guardian_relationship") @db.VarChar(50)
  guardianCaptureMethod ConsentCaptureMethod? @map("guardian_capture_method")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId], map: "patient_consents_tenant_id_idx")
  @@index([tenantId, patientId], map: "patient_consents_tenant_id_patient_id_idx")
  @@index([tenantId, patientId, consentType, status], map: "patient_consents_tenant_patient_type_status_idx")
  @@map("patient_consents")
}

// ---------------------------------------------------------------------------
// Provider (Workforce BC10)
// ---------------------------------------------------------------------------

/// Provider lifecycle status.
enum ProviderStatus {
  candidate
  onboarded
  active
  suspended
  separated
}

/// Canonical clinical-note author role, owned by the Clinical
/// Documentation bounded context (BC03) per ENUMS.md §4.2. BC03 is not
/// yet implemented; BC10 references this catalogue as a trusted
/// attribute on the Provider (see `Provider.clinicalAuthorRole`).
/// The values are the six ratified canonical ClinicalNoteAuthorRole
/// values (Physician, Nurse, Pharmacist, Therapist, Midlevel, Student).
/// `student` is supported, but interactive Student authoring is
/// deferred to BC03.
enum ClinicalNoteAuthorRole {
  physician
  nurse
  pharmacist
  therapist
  midlevel
  student
}

/// The canonical provider identity for the Ibn Hayan Healthcare Operating System.
///
/// Per download/docs/07_MODULES/DOCTORS.md Section 4.1:
/// - Provider and staff data is tenant-isolated by default
/// - A provider registered in tenant A is not visible to tenant B
///
/// Per DOCTORS.md Section 4.2:
/// - A provider's schedule may span multiple facilities
/// - The appointment context must verify that the provider is assigned
///   to the requested facility
///
/// This model implements the minimal canonical Provider persistence foundation
/// required for other bounded contexts, especially Appointments, to verify that
/// a provider reference genuinely exists within the authenticated tenant scope
/// and is eligible for a specific facility.
///
/// Tenant integrity: Provider is tenant-scoped. All assignment queries must
/// include tenantId. The database enforces that an assignment's tenantId matches
/// the provider's tenantId via a composite foreign key constraint added in the
/// migration. Application-layer tenantId filters provide the primary isolation
/// guarantee; database constraints provide the defense-in-depth guarantee.
///
/// Deliberately excluded (not in this minimal foundation):
/// - Demographics (name, contact information)
/// - Professional identity (license number, NPI, certifications)
/// - Credentials and privileging data
/// - Schedules and availability
/// - Patient panel assignments
/// - Productivity and performance metrics
/// - Compensation data
///
/// These fields will be added in subsequent batches as provider profiles
/// and credentialing are implemented.
model Provider {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  status             ProviderStatus          @default(candidate)
  clinicalAuthorRole ClinicalNoteAuthorRole? @map("clinical_author_role")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  facilityAssignments  ProviderFacilityAssignment[]
  userProviderBindings UserProviderBinding[]
  providerSchedules    ProviderSchedule[]

  // Unique constraint enables composite foreign key from provider_facility_assignments
  // that enforces tenant integrity: a provider can only be assigned within their tenant.
  @@unique([tenantId, id], map: "providers_tenant_id_id_key")
  @@index([tenantId], map: "providers_tenant_id_idx")
  @@index([tenantId, status], map: "providers_tenant_id_status_idx")
  @@map("providers")
}

/// Links a Provider to a Facility, enabling multi-facility provider assignments.
///
/// Per DOCTORS.md Section 4.2:
/// - A provider's schedule may span multiple facilities
/// - The appointment context must verify that the provider is assigned
///   to the requested facility
///
/// An active assignment has `revokedAt` set to null. A revoked assignment
/// indicates the provider no longer works at that facility.
///
/// Database Integrity Constraints (enforced via raw SQL in migration):
/// - Simple FK: provider_id → providers.id (Prisma convenience)
/// - Composite FK: (tenant_id, provider_id) → providers(tenant_id, id)
///   Ensures the provider belongs to the same tenant as the assignment.
/// - Simple FK: facility_id → facilities.id (Prisma convenience)
/// - Composite FK: (tenant_id, organisation_id, facility_id) →
///   facilities(tenant_id, organisation_id, id)
///   Enforces BOTH that the facility belongs to the same tenant as the
///   assignment AND that the facility belongs to the specified organisation.
/// - Partial unique index on (tenant_id, provider_id, facility_id)
///   WHERE revoked_at IS NULL: ensures only one active assignment per
///   tenant/provider/facility. Historical revoked assignments are
///   preserved for audit purposes. Reassignment after revocation is allowed.
///
/// Application-layer logic: all repository methods require tenantId as a
/// mandatory parameter. This provides the primary isolation guarantee.
/// Database constraints provide defense-in-depth.
///
/// Deliberately excluded (not in this minimal foundation):
/// - Assignment metadata (role at facility, department)
/// - Credentialing at facility level
/// - Privilege tracking
/// - Schedule templates per facility
model ProviderFacilityAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  facilityId     String    @map("facility_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Note: Full unique constraint removed. See migration for partial unique index
  // that enforces only one active (non-revoked) assignment per tenant/provider/facility.
  @@index([tenantId], map: "provider_facility_assignments_tenant_id_idx")
  @@index([tenantId, providerId], map: "provider_facility_assignments_tenant_id_provider_id_idx")
  @@index([tenantId, facilityId], map: "provider_facility_assignments_tenant_id_facility_id_idx")
  @@index([tenantId, providerId, revokedAt], map: "provider_facility_assignments_tenant_provider_revoked_idx")
  @@map("provider_facility_assignments")
}

// ---------------------------------------------------------------------------
// ProviderSchedule (BC10 — Provider Working-Hours / Availability Foundation)
// ---------------------------------------------------------------------------

/// BC10 Workforce owns provider schedule/availability data (per
/// DOCTORS.md §2.2 and APPOINTMENTS.md §2.1: "Workforce publishes
/// provider availability changes that Appointments consumes"). This
/// model is the minimum canonical weekly working-hours entry per
/// provider per facility, required for appointment eligibility
/// enforcement (BR-BC06-ADM-002).
///
/// Time semantics:
/// - `startTime` and `endTime` are local time-of-day values
///   (`@db.Time`) interpreted in the facility's configured IANA
///   timezone (Facility.timezone). A facility with a null timezone
///   is a configuration-required state; availability checks fail
///   closed for such facilities.
/// - `dayOfWeek` follows ISO 8601: 1 = Monday … 7 = Sunday. Enforced
///   by a CHECK constraint in the migration.
///
/// Deliberately excluded (deferred to later stages):
/// - Recurrence engines and slot-duration templates (BC06-owned)
/// - Schedule overrides, leave, and exceptions (BC10 future stage)
/// - Per-tenant configurable availability source (BR-BC06-ADM-002)
/// - Resource/room/equipment availability (BC06 multi-resource)
model ProviderSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  facilityId     String   @map("facility_id") @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([tenantId], map: "provider_schedules_tenant_id_idx")
  @@index([tenantId, providerId, facilityId], map: "provider_schedules_tenant_provider_facility_idx")
  @@index([tenantId, facilityId, providerId, dayOfWeek], map: "provider_schedules_availability_lookup_idx")
  @@map("provider_schedules")
}

// ---------------------------------------------------------------------------
// UserProviderBinding (BC10 — User→Provider Identity Binding Foundation)
// ---------------------------------------------------------------------------

/// The binding between a platform User (an authenticated identity, owned
/// by the Identity bounded context) and a Provider (a clinical-capacity
/// identity, owned by BC10). BC10 owns this binding.
///
/// Ratified cardinality (one-to-one INSIDE each tenant):
/// - One active Provider per User per tenant.
/// - One active User per Provider per tenant.
/// - The same global User may bind to different Providers in different
///   tenants. Uniqueness is therefore per-tenant, not global.
/// - NO automatic or backfill binding. Historical Users/Providers remain
///   valid without a binding; they simply cannot resolve a trusted
///   Provider identity until a binding is explicitly created.
///
/// An active binding has `revokedAt` set to null. Revoking a binding sets
/// `revokedAt`; a revoked binding is never returned by the active
/// resolution path. Historical revoked bindings are preserved for audit.
/// Re-binding after revocation is allowed.
///
/// Database Integrity Constraints (enforced via raw SQL in migration):
/// - Simple FK: user_id → users.id (Prisma convenience). The User is
///   global, so no tenant composite FK applies to user_id.
/// - Simple FK: provider_id → providers.id (Prisma convenience).
/// - Composite FK: (tenant_id, provider_id) → providers(tenant_id, id)
///   Ensures the Provider belongs to the same tenant as the binding.
/// - Partial unique index on (tenant_id, user_id) WHERE revoked_at IS NULL:
///   enforces one ACTIVE binding per user per tenant. Historical revoked
///   bindings are preserved; re-binding after revocation is allowed.
/// - Partial unique index on (tenant_id, provider_id) WHERE revoked_at IS
///   NULL: enforces one ACTIVE binding per provider per tenant.
///
/// The trusted `clinicalAuthorRole` is NOT stored on the binding; it lives
/// on the Provider. The server-side resolver reads it from the Provider at
/// resolution time so a status/role change is reflected immediately.
model UserProviderBinding {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Note: the per-tenant one-active-per-user and one-active-per-provider
  // cardinality is enforced by partial unique indexes declared in the
  // migration (WHERE revoked_at IS NULL). A composite FK
  // (tenant_id, provider_id) → providers(tenant_id, id) is also declared
  // in the migration to enforce provider tenant integrity.
  @@index([tenantId], map: "user_provider_bindings_tenant_id_idx")
  @@index([tenantId, userId], map: "user_provider_bindings_tenant_id_user_id_idx")
  @@index([tenantId, providerId], map: "user_provider_bindings_tenant_id_provider_id_idx")
  @@index([tenantId, userId, revokedAt], map: "user_provider_bindings_tenant_user_revoked_idx")
  @@map("user_provider_bindings")
}

// ---------------------------------------------------------------------------
// Encounter (BC02 — M02 Encounter / Clinical)
// ---------------------------------------------------------------------------

/// Encounter lifecycle status.
///
/// Canonical EncounterStatus enum (Closed) per
/// download/docs/03_DOMAIN/ENUMS.md §4.1 and
/// download/docs/03_DOMAIN/STATUS_CODES.md §5.1.
enum EncounterStatus {
  planned
  arrived
  in_progress
  on_leave
  finished
  cancelled
}

/// Encounter type.
///
/// Canonical EncounterType enum (Open-with-Council) per
/// download/docs/03_DOMAIN/ENUMS.md §4.2.
enum EncounterType {
  outpatient
  inpatient
  emergency
  telehealth
  home_health
  day_care
}

/// Encounter priority.
///
/// Canonical EncounterPriority enum (Closed) per
/// download/docs/03_DOMAIN/ENUMS.md §4.3.
enum EncounterPriority {
  routine
  urgent
  emergency
}

/// A single clinical encounter (BC02).
///
/// The Encounter is the platform's central organizing entity for a single
/// clinical event. It is owned by BC02 and references — but does NOT
/// foreign-key to — the Patient (BC01), Workforce/Provider (BC10), and
/// Scheduling/Appointment (BC06) bounded contexts. Those contexts own
/// their own authoritative state; this table holds logical identifiers
/// only, per SYSTEM_ARCHITECTURE §7.5 and MODULE_ARCHITECTURE §11.3
/// (state isolation).
///
/// patientId, providerId, and appointmentId are stored as UUID references
/// WITHOUT relational foreign keys. The application layer validates these
/// references via the owning modules' repositories before persisting.
///
/// appointmentId is nullable (emergency/walk-in encounters have no
/// appointment). When present, a partial unique index ensures one
/// encounter per appointment. When null, no uniqueness is enforced.
///
/// The canonical lifecycle is enforced at the application/repository
/// boundary via a conditional UPDATE ... WHERE status IN (...), NOT by a
/// database CHECK constraint. The database stores the status; the
/// repository enforces permitted source → target transitions atomically.
model Encounter {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  facilityId     String            @map("facility_id") @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  providerId     String            @map("provider_id") @db.Uuid
  appointmentId  String?           @map("appointment_id") @db.Uuid
  encounterType  EncounterType     @default(outpatient) @map("encounter_type")
  status         EncounterStatus   @default(planned)
  priority       EncounterPriority @default(routine)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, organisationId, facilityId, id], map: "encounters_tenant_org_facility_id_key")
  @@index([tenantId], map: "encounters_tenant_id_idx")
  @@index([tenantId, organisationId], map: "encounters_tenant_id_organisation_id_idx")
  @@index([tenantId, facilityId], map: "encounters_tenant_id_facility_id_idx")
  @@index([tenantId, patientId], map: "encounters_tenant_id_patient_id_idx")
  @@index([tenantId, providerId], map: "encounters_tenant_id_provider_id_idx")
  @@index([tenantId, appointmentId], map: "encounters_tenant_id_appointment_id_idx")
  @@index([tenantId, facilityId, status], map: "encounters_tenant_id_facility_id_status_idx")
  @@map("encounters")
}

// ---------------------------------------------------------------------------
// Clinical Note (BC03 — Clinical Documentation Foundation)
// ---------------------------------------------------------------------------

/// Canonical clinical note type per ENUMS.md §4.2 (ClinicalNoteType,
/// Open-with-Council). Bound to the LOINC document ontology. The database
/// stores lowercase values; the canonical default is `progress`.
enum ClinicalNoteType {
  progress
  history
  physical
  consultation
  discharge
  procedure
  nursing
}

/// Canonical clinical note lifecycle status per ENUMS.md §4.2 and
/// STATUS_CODES.md §5.3 (ClinicalNoteStatus, Closed). The database stores
/// lowercase values; the canonical default is `draft`. Terminal statuses:
/// `addendum`, `withdrawn`.
enum ClinicalNoteStatus {
  draft
  in_progress
  signed
  amended
  addendum
  withdrawn
}

/// The lifecycle action that produced a ClinicalNoteRevision. Records
/// which canonical lifecycle event created a revision, so the full
/// medico-legal history is reconstructable from the revision sequence.
enum ClinicalNoteRevisionAction {
  draft_created
  signed
  amended
  addendum_added
  withdrawn
}

/// A clinical note (BC03 — Clinical Documentation Foundation).
///
/// A ClinicalNote is a signed clinical document attached to an Encounter
/// (BC02). BC03 owns ClinicalNote state exclusively. The note references —
/// but does NOT foreign-key to — the Encounter (BC02), Patient (BC01), and
/// author Provider (BC10). Those contexts own their own authoritative
/// state; this table holds logical identifiers only, per the cross-BC
/// state-isolation rule ("Direct data access across context boundaries is a
/// defect and is rejected at code review"). No foreign keys cross BC
/// boundaries.
///
/// `encounterId`, `patientId`, and the author `providerId` (carried on the
/// revisions) are stored as UUID references WITHOUT relational foreign
/// keys. The application layer validates these references via the owning
/// modules' repositories before persisting.
///
/// The note's mutable content lives in an append-only sequence of
/// {@link ClinicalNoteRevision} rows (one-to-many). The current revision is
/// the latest one (highest `revisionNumber`). A signed revision is never
/// destructively rewritten: signing, amendment, addendum, and withdrawal
/// each produce a NEW revision while prior revisions are retained verbatim
/// (immutable, history-preserving medico-legal record).
///
/// The canonical lifecycle is enforced at the application/repository
/// boundary via a conditional UPDATE ... WHERE status IN (...), NOT by a
/// database CHECK constraint. The database stores the status; the
/// repository enforces permitted source → target transitions atomically
/// and appends a new revision within the same SERIALIZABLE transaction.
///
/// `authorRole` is the canonical author role of the note's original author
/// (the role on the draft revision). Per-revision author roles are carried
/// on each revision row (the author may differ across revisions for
/// co-authorship or amendment-by-another-clinician).
///
/// `signedAt` is the signing timestamp of the note's signed/current signed
/// revision; it is denormalised onto the note row for read efficiency but
/// the authoritative signed timestamp lives on the `signed` revision.
model ClinicalNote {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  organisationId String                 @map("organisation_id") @db.Uuid
  facilityId     String                 @map("facility_id") @db.Uuid
  encounterId    String                 @map("encounter_id") @db.Uuid
  patientId      String                 @map("patient_id") @db.Uuid
  noteType       ClinicalNoteType       @default(progress) @map("note_type")
  authorRole     ClinicalNoteAuthorRole @default(physician) @map("author_role")
  status         ClinicalNoteStatus     @default(draft)
  signedAt       DateTime?              @map("signed_at") @db.Timestamptz
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  revisions ClinicalNoteRevision[]

  @@unique([tenantId, organisationId, facilityId, id], map: "clinical_notes_tenant_org_facility_id_key")
  @@index([tenantId], map: "clinical_notes_tenant_id_idx")
  @@index([tenantId, organisationId], map: "clinical_notes_tenant_id_organisation_id_idx")
  @@index([tenantId, facilityId], map: "clinical_notes_tenant_id_facility_id_idx")
  @@index([tenantId, encounterId], map: "clinical_notes_tenant_id_encounter_id_idx")
  @@index([tenantId, patientId], map: "clinical_notes_tenant_id_patient_id_idx")
  @@index([tenantId, facilityId, status], map: "clinical_notes_tenant_id_facility_id_status_idx")
  @@map("clinical_notes")
}

/// An immutable revision in a ClinicalNote's append-only history.
///
/// Revisions are append-only: a new revision is created for every
/// lifecycle action that changes the note's content or status. A signed
/// revision (`action === 'signed'`) is never mutated; an amendment
/// (`action === 'amended'`) or addendum (`action === 'addendum_added'`)
/// creates a NEW revision with the corrected/supplementary content while
/// the prior signed revision is retained verbatim. The `revisionNumber`
/// is a 1-based sequence scoped to the note (enforced by a partial unique
/// index on `(clinical_note_id, revision_number)`); the highest
/// `revisionNumber` is the current revision.
///
/// `body` is the note's free-text clinical content as of this revision.
/// This is PHI; it is stored in the transactional database but is NEVER
/// placed in audit metadata.
///
/// `authorId` is a logical cross-BC reference to the authoring Provider
/// (BC10), stored as a UUID WITHOUT a foreign key (the Workforce bounded
/// context owns Provider state). The author of THIS revision may differ
/// across revisions for co-authorship or amendment-by-another-clinician.
///
/// `reason` is the mandatory reason for amendment/withdrawal/addendum
/// (BR-BC03-CLIN-032). `null` for draft creation and signing (no reason
/// required canonically).
///
/// `signedAt` is the signing timestamp, set only for `signed` revisions.
model ClinicalNoteRevision {
  id             String                     @id @default(uuid()) @db.Uuid
  clinicalNoteId String                     @map("clinical_note_id") @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  revisionNumber Int                        @map("revision_number")
  action         ClinicalNoteRevisionAction
  status         ClinicalNoteStatus
  body           String                     @db.Text
  authorId       String                     @map("author_id") @db.Uuid
  authorRole     ClinicalNoteAuthorRole     @map("author_role")
  reason         String?                    @db.Text
  signedAt       DateTime?                  @map("signed_at") @db.Timestamptz
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicalNoteId, revisionNumber], map: "clinical_note_revisions_note_id_revision_number_key")
  @@index([tenantId], map: "clinical_note_revisions_tenant_id_idx")
  @@index([clinicalNoteId], map: "clinical_note_revisions_clinical_note_id_idx")
  @@index([clinicalNoteId, revisionNumber], map: "clinical_note_revisions_note_id_revision_number_idx")
  @@map("clinical_note_revisions")
}

// ---------------------------------------------------------------------------
// Configuration (BC16)
// ---------------------------------------------------------------------------

/// The generic current-value store for registered Configuration keys.
/// The first vertical slice reviews three persistence scopes: L1
/// (Platform Default), L3 (Tenant), and L4 (Facility). The `value`
/// column is generic JSONB — a per-type column such as `value_int`
/// is deliberately not used, so future typed keys need no schema
/// change. Uniqueness of one active value per (key, layer, scope) is
/// enforced by partial unique indexes in the migration (one per
/// scope level); the composite scope-hierarchy foreign key and the
/// scope-coherence CHECK constraint are also enforced there. The
/// `valueVersion` column is the optimistic record version, checked
/// and incremented on every update.
model ConfigurationValue {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(160)
  layer          String   @db.VarChar(2)
  tenantId       String?  @map("tenant_id") @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  facilityId     String?  @map("facility_id") @db.Uuid
  value          Json     @db.JsonB
  valueVersion   Int      @default(1) @map("value_version")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  versions ConfigurationValueVersion[]

  @@index([key], map: "configuration_values_key_idx")
  @@index([tenantId], map: "configuration_values_tenant_id_idx")
  @@map("configuration_values")
}

/// The append-only version history for Configuration values. Every
/// successful create or update inserts exactly one immutable row in
/// the same transaction as the current-value write. Version rows
/// never receive UPDATE or DELETE statements (append-only); rollback
/// and comparison endpoints are deferred. Scoping columns mirror the
/// parent row so version history can be reconstructed by scope.
model ConfigurationValueVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  configurationValueId String   @map("configuration_value_id") @db.Uuid
  key                  String   @db.VarChar(160)
  layer                String   @db.VarChar(2)
  tenantId             String?  @map("tenant_id") @db.Uuid
  organisationId       String?  @map("organisation_id") @db.Uuid
  facilityId           String?  @map("facility_id") @db.Uuid
  value                Json     @db.JsonB
  valueVersion         Int      @map("value_version")
  actorId              String?  @map("actor_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  configurationValue ConfigurationValue @relation(fields: [configurationValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([configurationValueId], map: "configuration_value_versions_value_id_idx")
  @@index([key], map: "configuration_value_versions_key_idx")
  @@map("configuration_value_versions")
}
